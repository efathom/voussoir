# Copy to .env and fill in real values. .env is gitignored; .env.example is the
# committed reference. voussoir reads config from the environment only — load
# .env via direnv, `set -a; source .env; set +a`, or `make run-<example>`.

# Required for every runnable example. Any one of the three provider keys is
# enough; default_container() picks the first it finds.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...

# 02b_research_agent_yase only (after `docker compose -f
# examples/02b_research_agent_yase/docker-compose.yml up -d`):
YASE_URL=http://localhost:8000
# YASE_API_KEY=...   # only if the yase server has YASE_AUTH_ENABLED=true

# 04_a2a_peer only — share the same secret between both terminals. Generate one
# with:
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
VOUSSOIR_A2A_JWT_SECRET=
# Publisher must explicitly allow the caller's issuer; the caller agent is
# named 'lead' (Phase 4.5a P0 #2: default-deny):
VOUSSOIR_A2A_ALLOWED_ISSUERS=lead